<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/interface_menu_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="335dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lockscreen_section"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:layout_marginStart="16dp"
            android:background="@*android:color/transparent"
            android:clipToOutline="true"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <com.orion.support.helpers.WallpaperView
                android:id="@+id/lockscreen_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/object_area"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:id="@+id/icon_area_ls"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="top|left">

                    <androidx.cardview.widget.CardView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        app:cardBackgroundColor="?android:colorBackground"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="99dp">
                    
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_settings_lockscreen"
                                android:tint="?android:textColorPrimary" />    
                    
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <RelativeLayout
                    android:id="@+id/text_area_ls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="bottom|left"
                    android:layout_marginTop="-16dp">

                    <TextView
                        android:id="@+id/lockscreen_title"
                        android:textSize="19sp"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lockscreen_title" />

                    <TextView
                        android:id="@+id/lockscreen_summary"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lockscreen_title"
                        android:layout_alignStart="@+id/lockscreen_title"
                        android:singleLine="false"
                        android:text="@string/lockscreen_summary"
                        android:elevation="5dp" />
                </RelativeLayout>        

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.7"
            android:orientation="vertical">

            <LinearLayout
                android:gravity="start|center"
                android:orientation="vertical"
                android:id="@+id/about_section"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/card_view_half_top"
                android:padding="16dp"
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/icon_area_about"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginBottom="12dp"
                    android:layout_gravity="left">

                    <androidx.cardview.widget.CardView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        app:cardBackgroundColor="?android:colorBackground"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="99dp">
                    
                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:src="@drawable/ic_settings_orion" />    
                    
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <TextView
                    android:textSize="19sp"
                    android:textColor="?android:colorPrimary"
                    android:gravity="start"
                    android:id="@+id/about_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/about_title" />
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:colorSecondary"
                    android:id="@+id/about_summary"
                    android:gravity="start"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/about_summary" />
            </LinearLayout>

            <LinearLayout
                android:gravity="start|center"
                android:orientation="vertical"
                android:id="@+id/quicksettings_section"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/card_view_half_bottom"
                android:padding="16dp"
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1">
                
                <FrameLayout
                    android:id="@+id/icon_area_qs"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginBottom="12dp"
                    android:layout_gravity="left">

                    <androidx.cardview.widget.CardView
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        app:cardBackgroundColor="?android:colorBackground"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="99dp">
                    
                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:src="@drawable/ic_settings_quicksettings"
                                android:tint="?android:textColorPrimary" />    
                    
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <TextView
                    android:textSize="19sp"
                    android:textColor="?android:textColorPrimary"
                    android:gravity="start"
                    android:id="@+id/quicksettings_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/quicksettings_title" />
                
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:textColorSecondary"
                    android:id="@+id/quicksettings_summary"
                    android:gravity="start"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/quicksettings_summary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>